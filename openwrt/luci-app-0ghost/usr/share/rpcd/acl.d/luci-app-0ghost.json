{
	"luci-app-0ghost": {
		"description": "Grant access to 0Ghost side-router gateway status and service control",
		"read": {
			"file": {
				"/etc/0ghost/*": [ "read" ],
				"/etc/init.d/0ghost": [ "exec" ],
				"/etc/init.d/0ghost *": [ "exec" ]
			},
			"ubus": {
				"file": [ "read", "stat", "exec" ],
				"service": [ "list" ]
			}
		},
		"write": {
			"file": {
				"/etc/0ghost/*": [ "write" ],
				"/etc/init.d/0ghost": [ "exec" ],
				"/etc/init.d/0ghost *": [ "exec" ]
			},
			"ubus": {
				"file": [ "write", "exec" ]
			}
		}
	}
}
