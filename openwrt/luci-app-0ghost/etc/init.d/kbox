#!/bin/sh /etc/rc.common
# KestrelBox (kbox) OpenWrt / iStoreOS procd service

START=96
STOP=15
USE_PROCD=1

PROG=/usr/bin/kbox
CONF=/etc/kbox/config.json

start_service() {
	mkdir -p /etc/kbox
	# Lossless migration from legacy 0ghost config if present
	if [ ! -f "$CONF" ] && [ -f /etc/0ghost/config.json ]; then
		cp -f /etc/0ghost/config.json "$CONF"
	fi
	procd_open_instance kbox
	procd_set_param command "$PROG" -config "$CONF" -web 0.0.0.0:19080
	procd_set_param env GOGC=40 GOMEMLIMIT=240MiB
	procd_set_param respawn 3600 5 5
	procd_set_param limits nofile="65535 65535"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	"$PROG" -cleanup >/dev/null 2>&1 || true
}
