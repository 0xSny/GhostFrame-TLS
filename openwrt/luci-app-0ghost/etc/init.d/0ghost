#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

PROG=/usr/bin/0ghost
CONF_FILE=/etc/0ghost/config.json

start_service() {
	mkdir -p /etc/0ghost
	procd_open_instance
	procd_set_param command "$PROG" -config "$CONF_FILE"
	procd_set_param env TZ=CST-8
	procd_set_param limits nofile="65536 65536"
	procd_set_param respawn 3600 2 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	[ -x "$PROG" ] && "$PROG" -cleanup >/dev/null 2>&1 || true
}

reload_service() {
	stop
	start
}
